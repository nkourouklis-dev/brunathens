{
  "name": "cafe-orders-worker",
  "version": "1.0.0",
  "description": "Coffee shop order API for Cloudflare Worker + D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev --local --persist --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create cafe-orders-db --local",
    "db:push": "wrangler d1 execute cafe-orders-db --local --file ./migrations/0001_initial.sql"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "d1",
    "coffee"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "webpush-webcrypto": "^1.0.5",
    "wrangler": "^4.129.0"
  },
  "devDependencies": {
    "web-push": "^3.6.7"
  }
}
